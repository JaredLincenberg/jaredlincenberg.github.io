source "https://rubygems.org"

# Plain Jekyll (not the github-pages meta-gem) so local builds work with
# modern Ruby. GitHub Pages builds the deployed site with its own
# environment regardless of this Gemfile, as long as we stick to
# Pages-supported plugins.
gem "jekyll", "~> 4.3"
gem "jekyll-feed"

# Ruby 3.4+ no longer bundles these by default; some transitive
# dependencies still expect them to be available.
gem "csv"
gem "logger"
gem "base64"
gem "bigdecimal"
